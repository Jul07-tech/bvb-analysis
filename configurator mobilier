%%writefile app.py
import streamlit as st
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.patches as patches
import io

from reportlab.lib.pagesizes import A4, landscape
from reportlab.lib import colors
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, Table, TableStyle, Image, PageBreak
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle

st.set_page_config(page_title="Configurator Mobilier & Export PDF Execuție", layout="wide")

st.title("🛋️ Configurator Mobilier Smart - Desene Execuție & Export PDF")
st.caption("Proiectare asistată, matrice System 32, desene de execuție și export PDF tehnic")

# ==========================================
# 1. PARAMETRI ȘI INTRARE DATE
# ==========================================
GROSIME_PAL = 18   # mm
ROST_USA = 3        # mm

DECORURI = {
    "Alb Cratere (W980 ST9)": 65.0,
    "Gri Antracit (U999 ST9)": 85.0,
    "Stejar Hunton Natur (H2038 ST19)": 115.0,
    "Nuc Pacific Tabac (H3700 ST10)": 125.0
}

CATALOG_GLISIERE = {
    "Blum TANDEMBOX Antaro (Sertar Metalic + Amortizare)": {"joc": 37, "extracție": "Totală", "pret": 120.0},
    "Blum TANDEM Partial (Sertar Lemn + Soft-Close)": {"joc": 26, "extracție": "Parțială", "pret": 65.0},
    "Blum TANDEM Total (Sertar Lemn + Tip-On Push)": {"joc": 26, "extracție": "Totală", "pret": 85.0},
    "Glisiere Telescopice cu Bile (Standard)": {"joc": 25.4, "extracție": "Totală", "pret": 35.0}
}

st.sidebar.header("📏 Dimensiuni Totale Corp (mm)")
L = st.sidebar.number_input("Lungime (L)", min_value=300, max_value=4000, value=1200, step=50)
H = st.sidebar.number_input("Înălțime (H)", min_value=300, max_value=2400, value=720, step=50)
A = st.sidebar.number_input("Adâncime (A)", min_value=200, max_value=900, value=500, step=10)

st.sidebar.header("🎨 Finisaje & Feronerie")
decor_carcasa = st.sidebar.selectbox("Decor Carcasă", list(DECORURI.keys()), index=2)
decor_fronturi = st.sidebar.selectbox("Decor Fronturi", list(DECORURI.keys()), index=2)
tip_corp = st.sidebar.selectbox("Tipologie", ["Corp Bază cu Uși", "Comodă cu Sertare"])
numar_compartimente = st.sidebar.number_input("Număr compartimente / sertare / uși", min_value=1, max_value=6, value=2)

tip_glisiera = st.sidebar.selectbox("Tip Glisiere Sertar", list(CATALOG_GLISIERE.keys()))

st.sidebar.header("💰 Prețuri Unitare (RON)")
pret_pal = DECORURI[decor_carcasa]
pret_cant = st.sidebar.number_input("Preț Cant ABS (RON/m)", value=3.5)
pret_hdf = st.sidebar.number_input("Preț Spate HDF (RON/mp)", value=20.0)

# ==========================================
# 2. CALCULE CORECTE SYSTEM 32 & MATRICE GĂURI
# ==========================================
piese = []
gauri_map = {}

l_orizontale = L - (2 * GROSIME_PAL)
joc_glisiera = CATALOG_GLISIERE[tip_glisiera]["joc"]

if tip_corp == "Corp Bază cu Uși":
    l_usa = (L / numar_compartimente) - ROST_USA
    h_usa = H - ROST_USA
    
    piese.append({"Piesă": "Laterală Stânga/Dreapta", "Buc": 2, "Lungime (mm)": H, "Lățime (mm)": A, "Material": decor_carcasa})
    piese.append({"Piesă": "Ușă Standard", "Buc": numar_compartimente, "Lungime (mm)": h_usa, "Lățime (mm)": l_usa, "Material": decor_fronturi})
    piese.append({"Piesă": "Fund / Blat", "Buc": 2, "Lungime (mm)": l_orizontale, "Lățime (mm)": A, "Material": decor_carcasa})
    piese.append({"Piesă": "Spate HDF", "Buc": 1, "Lungime (mm)": H - 4, "Lățime (mm)": L - 4, "Material": "HDF 3mm"})

    # Corecție cote Blum System 32 (Plăcuțe montaj la pas de 32 mm pe Y)
    gauri_map["Laterală Stânga/Dreapta"] = [
        {"x": 37, "y": 9, "d": 5, "prof": 12, "desc": "Confirmator Fund Spate"},
        {"x": A - 37, "y": 9, "d": 5, "prof": 12, "desc": "Confirmator Fund Față"},
        {"x": 37, "y": H - 9, "d": 5, "prof": 12, "desc": "Confirmator Top Spate"},
        {"x": A - 37, "y": H - 9, "d": 5, "prof": 12, "desc": "Confirmator Top Față"},
        # Plăcuță jos (Pas 32mm)
        {"x": 37, "y": 100, "d": 5, "prof": 12, "desc": "Plăcuță Balama Jos (Gaură 1)"},
        {"x": 37, "y": 132, "d": 5, "prof": 12, "desc": "Plăcuță Balama Jos (Gaură 2 - System 32)"},
        # Plăcuță sus (Pas 32mm)
        {"x": 37, "y": H - 100, "d": 5, "prof": 12, "desc": "Plăcuță Balama Sus (Gaură 1)"},
        {"x": 37, "y": H - 132, "d": 5, "prof": 12, "desc": "Plăcuță Balama Sus (Gaură 2 - System 32)"}
    ]

    # Corecție frezare oală balama Blum (Centru oală X=22mm față de margine)
    gauri_map["Ușă Standard"] = [
        {"x": 22, "y": 100, "d": 35, "prof": 12.5, "desc": "Oală Balama Jos Ø35 (K=4mm)"},
        {"x": 22, "y": H - 100, "d": 35, "prof": 12.5, "desc": "Oală Balama Sus Ø35 (K=4mm)"}
    ]

    gauri_map["Fund / Blat"] = [
        {"x": 9, "y": 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Stânga Spate"},
        {"x": 9, "y": A - 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Stânga Față"},
        {"x": l_orizontale - 9, "y": 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Dreapta Spate"},
        {"x": l_orizontale - 9, "y": A - 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Dreapta Față"}
    ]

else:  # Comodă cu Sertare
    h_sertar = (H - 36) / numar_compartimente
    l_front_sertar = L - ROST_USA
    a_sertar = A - 50
    l_caseta_sertar = l_orizontale - joc_glisiera

    piese.append({"Piesă": "Laterală Comodă", "Buc": 2, "Lungime (mm)": H, "Lățime (mm)": A, "Material": decor_carcasa})
    piese.append({"Piesă": "Front Sertar", "Buc": numar_compartimente, "Lungime (mm)": h_sertar, "Lățime (mm)": l_front_sertar, "Material": decor_fronturi})
    piese.append({"Piesă": "Blat / Fund", "Buc": 2, "Lungime (mm)": l_orizontale, "Lățime (mm)": A, "Material": decor_carcasa})
    piese.append({"Piesă": "Spate Comodă HDF", "Buc": 1, "Lungime (mm)": H - 4, "Lățime (mm)": L - 4, "Material": "HDF 3mm"})
    
    if "TANDEMBOX" not in tip_glisiera:
        piese.append({"Piesă": "Laterală Sertar Lemn", "Buc": numar_compartimente * 2, "Lungime (mm)": a_sertar, "Lățime (mm)": 150, "Material": decor_carcasa})
        piese.append({"Piesă": "Spate/Față Sertar Lemn", "Buc": numar_compartimente * 2, "Lungime (mm)": l_caseta_sertar - (2 * GROSIME_PAL), "Lățime (mm)": 150, "Material": decor_carcasa})

    gauri_laterala_sertar = [
        {"x": 37, "y": 9, "d": 5, "prof": 12, "desc": "Confirmator Jos Spate"},
        {"x": A - 37, "y": 9, "d": 5, "prof": 12, "desc": "Confirmator Jos Față"}
    ]
    
    # Fixare șine glisiere (System 32: 37mm și 224mm față de margine)
    for i in range(numar_compartimente):
        y_sine = 50 + i * h_sertar
        gauri_laterala_sertar.append({"x": 37, "y": y_sine, "d": 5, "prof": 12, "desc": f"Glisieră {i+1} Gaură 1 (37mm)"})
        gauri_laterala_sertar.append({"x": 224, "y": y_sine, "d": 5, "prof": 12, "desc": f"Glisieră {i+1} Gaură 2 (System 32)"})

    gauri_map["Laterală Comodă"] = gauri_laterala_sertar

    gauri_map["Front Sertar"] = [
        {"x": 50, "y": 32, "d": 10, "prof": 12, "desc": "Fixare Cuplaj Stânga"},
        {"x": l_front_sertar - 50, "y": 32, "d": 10, "prof": 12, "desc": "Fixare Cuplaj Dreapta"}
    ]

    gauri_map["Blat / Fund"] = [
        {"x": 9, "y": 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Stânga Spate"},
        {"x": l_orizontale - 9, "y": 37, "d": 8, "prof": 30, "desc": "Găurire Cânt Dreapta Spate"}
    ]

df_piese = pd.DataFrame(piese)

# ==========================================
# 3. GENERARE BOM LIST
# ==========================================
df_piese["Suprafață_mp"] = (df_piese["Lungime (mm)"] * df_piese["Lățime (mm)"] / 1_000_000) * df_piese["Buc"]
df_piese["Perimetru_m"] = ((df_piese["Lungime (mm)"] + df_piese["Lățime (mm)"]) * 2 / 1000) * df_piese["Buc"]

mp_pal_total = df_piese[df_piese["Material"] != "HDF 3mm"]["Suprafață_mp"].sum()
mp_hdf_total = df_piese[df_piese["Material"] == "HDF 3mm"]["Suprafață_mp"].sum()
cant_abs_m = df_piese[df_piese["Material"] != "HDF 3mm"]["Perimetru_m"].sum() * 0.5

bom_items = [
    {"Categorie": "Plăci PAL", "Articol": f"PAL Melaminat 18mm ({decor_carcasa})", "Cantitate": round(mp_pal_total, 2), "UM": "mp", "Preț Unitar (RON)": pret_pal, "Valoare Totală (RON)": round(mp_pal_total * pret_pal, 2)},
    {"Categorie": "Plăci HDF", "Articol": "HDF 3mm Spate/Fund", "Cantitate": round(mp_hdf_total, 2), "UM": "mp", "Preț Unitar (RON)": pret_hdf, "Valoare Totală (RON)": round(mp_hdf_total * pret_hdf, 2)},
    {"Categorie": "Canturi", "Articol": "Cant ABS 0.8mm / 22mm", "Cantitate": round(cant_abs_m, 1), "UM": "m", "Preț Unitar (RON)": pret_cant, "Valoare Totală (RON)": round(cant_abs_m * pret_cant, 2)},
]

if tip_corp == "Comodă cu Sertare":
    pret_g = CATALOG_GLISIERE[tip_glisiera]["pret"]
    bom_items.append({"Categorie": "Feronerie", "Articol": f"Set Glisiere {tip_glisiera.split('(')[0]}", "Cantitate": numar_compartimente, "UM": "set", "Preț Unitar (RON)": pret_g, "Valoare Totală (RON)": round(numar_compartimente * pret_g, 2)})
else:
    bom_items.append({"Categorie": "Feronerie", "Articol": "Balamale Blum CLIP top BLUMOTION", "Cantitate": numar_compartimente * 2, "UM": "buc", "Preț Unitar (RON)": 15.0, "Valoare Totală (RON)": round(numar_compartimente * 2 * 15.0, 2)})

df_bom = pd.DataFrame(bom_items)
cost_total_proiect = df_bom["Valoare Totală (RON)"].sum()

# ==========================================
# 4. GENERARE MATPLOTLIB PENTRU ECRAN & PDF
# ==========================================
def deseneaza_schita_matplotlib(nume, latime, lungime, gauri):
    fig, ax = plt.subplots(figsize=(7, 4))
    rect = patches.Rectangle((0, 0), latime, lungime, linewidth=2, edgecolor='#2c3e50', facecolor='#f8f9fa')
    ax.add_patch(rect)
    
    for g in gauri:
        color = '#e74c3c' if g['d'] == 35 else ('#2ecc71' if g['d'] == 10 else '#3498db')
        circle = patches.Circle((g['x'], g['y']), radius=max(g['d']*0.8, 6), color=color, alpha=0.8)
        ax.add_patch(circle)
        ax.text(g['x'], g['y'] + 15, f"Ø{g['d']} (x:{int(g['x'])}, y:{int(g['y'])})", 
                fontsize=7, ha='center', va='bottom', bbox=dict(boxstyle="round,pad=0.2", fc="white", ec="gray", lw=0.5))

    ax.set_xlim(-40, latime + 60)
    ax.set_ylim(-40, lungime + 60)
    ax.set_aspect('equal')
    plt.title(f"Desen Execuție 2D: {nume} ({int(latime)} x {int(lungime)} mm)", fontsize=10, fontweight='bold')
    plt.xlabel("X (mm)")
    plt.ylabel("Y (mm)")
    plt.grid(True, linestyle='--', alpha=0.4)
    return fig

# ==========================================
# 5. GENERARE EXPORT PDF COMPLEAT (REPORTLAB)
# ==========================================
def genereaza_pdf_executie():
    buffer = io.BytesIO()
    doc = SimpleDocTemplate(buffer, pagesize=landscape(A4), rightMargin=30, leftMargin=30, topMargin=30, bottomMargin=30)
    story = []
    
    styles = getSampleStyleSheet()
    title_style = ParagraphStyle('TitleStyle', parent=styles['Heading1'], fontSize=18, textColor=colors.HexColor('#2c3e50'), spaceAfter=12)
    subtitle_style = ParagraphStyle('SubTitleStyle', parent=styles['Heading2'], fontSize=12, textColor=colors.HexColor('#34495e'), spaceAfter=8)

    # Pagina 1: Antet + BOM List
    story.append(Paragraph("📐 DOSAR TEHNIC DE EXECUȚIE ȘI DEBITARE MOBILIER", title_style))
    story.append(Paragraph(f"<b>Tipologie Corp:</b> {tip_corp} | <b>Dimensiuni Gabarit:</b> {L} x {H} x {A} mm", subtitle_style))
    story.append(Spacer(1, 10))
    
    story.append(Paragraph("<b>1. Bill of Materials (BOM List & Costuri)</b>", subtitle_style))
    bom_data = [df_bom.columns.tolist()] + df_bom.values.tolist()
    t_bom = Table(bom_data, colWidths=[110, 220, 60, 40, 90, 100])
    t_bom.setStyle(TableStyle([
        ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#2c3e50')),
        ('TEXTCOLOR', (0,0), (-1,0), colors.white),
        ('FONTNAME', (0,0), (-1,0), 'Helvetica-Bold'),
        ('FONTSIZE', (0,0), (-1,-1), 8),
        ('GRID', (0,0), (-1,-1), 0.5, colors.grey),
        ('ALIGN', (3,0), (-1,-1), 'CENTER')
    ]))
    story.append(t_bom)
    story.append(Spacer(1, 15))
    
    story.append(Paragraph(f"<b>COST TOTAL ESTIMAT: {round(cost_total_proiect, 2)} RON</b>", title_style))
    story.append(PageBreak())

    # Pagini următoare: Câte o piesă per pagină cu Schiță 2D și Matrice CNC
    for piesa_nume, gauri in gauri_map.items():
        info_piesa = df_piese[df_piese["Piesă"] == piesa_nume].iloc[0]
        
        story.append(Paragraph(f"<b>PLANȘĂ EXECUTIE 2D: {piesa_nume.upper()}</b>", title_style))
        story.append(Paragraph(f"Dimensiuni: <b>{info_piesa['Lungime (mm)']} x {info_piesa['Lățime (mm)']} mm</b> | Bucăți: <b>{info_piesa['Buc']} buc</b> | Material: <b>{info_piesa['Material']}</b>", subtitle_style))
        story.append(Spacer(1, 10))

        # Salvare figura Matplotlib ca imagine în memorie
        fig = deseneaza_schita_matplotlib(piesa_nume, info_piesa["Lățime (mm)"], info_piesa["Lungime (mm)"], gauri)
        img_buf = io.BytesIO()
        fig.savefig(img_buf, format='png', bbox_inches='tight', dpi=150)
        plt.close(fig)
        img_buf.seek(0)

        # Tabel CNC
        df_g = pd.DataFrame(gauri)
        df_g.columns = ["X (mm)", "Y (mm)", "Ø (mm)", "Prof (mm)", "Operațiune"]
        cnc_data = [df_g.columns.tolist()] + df_g.values.tolist()
        t_cnc = Table(cnc_data, colWidths=[50, 50, 50, 60, 180])
        t_cnc.setStyle(TableStyle([
            ('BACKGROUND', (0,0), (-1,0), colors.HexColor('#34495e')),
            ('TEXTCOLOR', (0,0), (-1,0), colors.white),
            ('FONTSIZE', (0,0), (-1,-1), 8),
            ('GRID', (0,0), (-1,-1), 0.5, colors.grey),
        ]))

        # Alăturare desen 2D și Tabel Coordonate
        img_reportlab = Image(img_buf, width=380, height=220)
        t_layout = Table([[img_reportlab, t_cnc]])
        story.append(t_layout)
        story.append(PageBreak())

    doc.build(story)
    buffer.seek(0)
    return buffer

# ==========================================
# 6. INTERFAȚĂ PRINCIPALĂ (STREAMLIT)
# ==========================================
st.subheader("📊 BOM List - Listă de Rețetă Materiale și Costuri Totalizate")
st.dataframe(df_bom, use_container_width=True)

m1, m2 = st.columns([2, 2])
m1.metric("COST TOTAL ESTIMAT PROIECT", f"{round(cost_total_proiect, 2)} RON")

pdf_bytes = genereaza_pdf_executie()
m2.download_button(
    label="📄 Descarcă Dosar Tehnic complet (PDF A4 - Desene Execuție 2D)",
    data=pdf_bytes,
    file_name=f"Dosar_Tehnic_Executie_{tip_corp.replace(' ', '_')}.pdf",
    mime="application/pdf"
)

st.markdown("---")
st.subheader("📋 Lista de Debitare (Lista Tăiere)")
st.dataframe(df_piese[["Piesă", "Buc", "Lungime (mm)", "Lățime (mm)", "Material"]], use_container_width=True)

st.markdown("---")
st.subheader("📐 Desene de Execuție 2D și Matrice Găurire (System 32)")

lista_piese_nume = list(gauri_map.keys())
tabs = st.tabs([f"📄 {p}" for p in lista_piese_nume])

for idx, piesa_nume in enumerate(lista_piese_nume):
    with tabs[idx]:
        info_piesa = df_piese[df_piese["Piesă"] == piesa_nume].iloc[0]
        gauri = gauri_map[piesa_nume]
        
        c1, c2 = st.columns([3, 2])
        
        with c1:
            fig_2d = deseneaza_schita_matplotlib(piesa_nume, info_piesa["Lățime (mm)"], info_piesa["Lungime (mm)"], gauri)
            st.pyplot(fig_2d)
            
        with c2:
            st.markdown(f"**Coordonate Centru Găuri (CNC / Atelier):**")
            df_g = pd.DataFrame(gauri)
            df_g.columns = ["X (mm)", "Y (mm)", "Diametru Ø", "Adâncime (mm)", "Operațiune"]
            st.dataframe(df_g, use_container_width=True)
            st.caption(f"Bucăți necesare în proiect: **{info_piesa['Buc']} buc**")
